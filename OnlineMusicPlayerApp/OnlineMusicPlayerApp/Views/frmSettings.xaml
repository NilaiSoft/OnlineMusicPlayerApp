<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OnlineMusicPlayerApp.Views.frmSettings"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0D1B2A"
             Title="{Binding Title}">

    <ContentPage.Content>
        <Grid Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header Image -->
                <RowDefinition Height="Auto"/>
                <!-- Menu & Title -->
                <RowDefinition Height="Auto"/>
                <!-- Send SMS -->
                <RowDefinition Height="Auto"/>
                <!-- Question SMS -->
                <RowDefinition Height="Auto"/>
                <!-- Reload Followers -->
                <RowDefinition Height="Auto"/>
                <!-- Reload Followers -->
                <RowDefinition Height="Auto"/>
                <!-- Submit Button -->
            </Grid.RowDefinitions>

            <!-- 🖼️ Header Image -->
            <Image Grid.Row="0" Source="img0.png" Aspect="Fill" HeightRequest="100"/>

            <!-- 📋 Menu & Title -->
            <StackLayout Grid.Row="1" Orientation="Horizontal" Spacing="15" Margin="0,20,0,0">
                <ImageButton Source="menu.png"
                             x:Name="btnMenu"
                             Clicked="btnMenu_Clicked"
                             BackgroundColor="Transparent"
                             WidthRequest="40" HeightRequest="40"
                             VerticalOptions="Center"/>
                <Label Text="تنظیمات"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalOptions="Center"/>
            </StackLayout>

            <!-- ✉️ Send SMS -->
            <Frame Grid.Row="2" BackgroundColor="#1B263B" CornerRadius="10" Padding="10" Margin="0,10,0,0">
                <StackLayout Orientation="Horizontal">
                    <Switch x:Name="chkSendSMS" Toggled="chkSendSMS_Toggled"/>
                    <Label Text="ارسال پیامک برنده"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           Margin="10,0,0,0"
                           VerticalOptions="Center"/>
                </StackLayout>
            </Frame>

            <!-- ❓ Question SMS -->
            <Frame Grid.Row="3" BackgroundColor="#1B263B" CornerRadius="10" Padding="10" Margin="0,10,0,0">
                <StackLayout Orientation="Horizontal">
                    <Switch x:Name="chkQuestionSMS" Toggled="chkQuestionSMS_Toggled"/>
                    <Label Text="نمایش پرسش ارسال پیامک"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           Margin="10,0,0,0"
                           VerticalOptions="Center"/>
                </StackLayout>
            </Frame>

            <Frame Grid.Row="4" BackgroundColor="#1B263B" CornerRadius="10" Padding="10" Margin="0,10,0,0">
                <StackLayout Orientation="Horizontal">
                    <Switch x:Name="chkOpenWinnerPage" Toggled="chkOpenWinnerPage_Toggled"/>
                    <Label Text="نمایش فرم برنده"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           Margin="10,0,0,0"
                           VerticalOptions="Center"/>
                </StackLayout>
            </Frame>

            <!-- 👥 Reload Followers (Hidden) -->
            <Frame Grid.Row="5" IsVisible="False" BackgroundColor="#1B263B" CornerRadius="10" Padding="10" Margin="0,10,0,0">
                <StackLayout Orientation="Horizontal">
                    <Switch x:Name="chkIsRelodFollowerList"/>
                    <Label Text="بارگذاری لیست فالورها"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White"
                           Margin="10,0,0,0"
                           VerticalOptions="Center"/>
                </StackLayout>
            </Frame>

            <!-- ✅ Submit Button -->
            <StackLayout Grid.Row="6" VerticalOptions="End" Margin="0,20,0,0" IsVisible="True">
                <Button Text="ذخیره"
                        BackgroundColor="#2ECC71"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="Medium"
                        CornerRadius="10"
                        Margin="80,10"
                        x:Name="btnSubmit"
                        Clicked="btnSubmit_Clicked"/>
            </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>
