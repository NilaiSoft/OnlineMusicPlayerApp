<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:OnlineMusicPlayerApp.Views"
             x:Class="OnlineMusicPlayerApp.Views.DetailPages"
             BackgroundColor="#F5F0EB"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Content>
        <StackLayout>
            <StackLayout x:Name="stack" Padding="30" Spacing="1">
                <!-- لیست آیتم‌ها -->
                <ListView x:Name="DetailsListView"
                      HasUnevenRows="True"
                      SeparatorVisibility="None"
                      BackgroundColor="Transparent"
                      ItemTapped="DetailsListView_ItemTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Frame BackgroundColor="#eeeeee"
                                   CornerRadius="8"
                                   Padding="12"
                                   Margin="5">
                                    <Label Text="{Binding Title}"
                                       TextColor="Black"
                                       FontSize="16"
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center" />
                                </Frame>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </StackLayout>
            <views:MiniPlayerView Grid.Row="1"
                              HorizontalOptions="FillAndExpand"
                              HeightRequest="200" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
