<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://xamarin.com/schemas/2020/toolkit"
             x:Class="OnlineMusicPlayerApp.Views.DetailPages"
             BackgroundColor="#F5F0EB"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Content>
        <StackLayout x:Name="stack" Padding="30" Spacing="25">

            <Label FontSize="18"
                   x:Name="lblTitle"
                   TextColor="#3E3E3E"
                   HorizontalOptions="Center" />
            <!-- عکس کاور آهنگ -->
            <Image x:Name="CoverImage"
                   Grid.Row="0"
                   Aspect="AspectFill"
                   HorizontalOptions="Center"
                   HeightRequest="200"
                   WidthRequest="200">
                <Image.Clip>
                    <EllipseGeometry Center="100,100" RadiusX="100" RadiusY="100" />
                </Image.Clip>
            </Image>


            <toolkit:MediaElement x:Name="Player"
                      HeightRequest="1"
                      WidthRequest="1"
                      AutoPlay="True"
                      ShowsPlaybackControls="False"
                      IsEnabled="False"
                      Opacity="0"
                      BackgroundColor="Transparent"
                      HorizontalOptions="Start"
                      VerticalOptions="Start" />
            
            <Label x:Name="CurrentTimeLabel"
                   Text="0:00"
                   FontSize="14"
                   TextColor="#555"
                   VerticalOptions="Center" />



            <Slider x:Name="ProgressSlider"
                    Minimum="0"
                    Maximum="1"
                    Value="0"
                    ValueChanged="ProgressSlider_ValueChanged"
                    HorizontalOptions="FillAndExpand"
                    ThumbColor="#888"
                    MinimumTrackColor="#555"
                    MaximumTrackColor="#CCC" />


            <Label x:Name="TotalTimeLabel"
                    Text="0:00"
                    FontSize="14"
                    TextColor="#555"
                    VerticalOptions="Center" />

            <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="20">
                <Button x:Name="btnPlay" ImageSource="icon_play3" BackgroundColor="Transparent" Clicked="OnPlayClicked" />
            </StackLayout>

        </StackLayout>
    </ContentPage.Content>
</ContentPage>
