<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:OnlineMusicPlayerApp.Views"
             x:Class="OnlineMusicPlayerApp.Views.DetailPages"
             BackgroundColor="#F5F0EB"
             NavigationPage.HasNavigationBar="False"
             Padding="0,30,0,0">

    <ContentPage.Content>
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 📜 لیست آهنگ‌ها -->
            <ListView Grid.Row="0"
                      x:Name="DetailsListView"
                      HasUnevenRows="True"
                      IsPullToRefreshEnabled="True"
                      IsRefreshing="False"
                      Refreshing="DetailsListView_Refreshing"
                      SeparatorVisibility="None"
                      BackgroundColor="Transparent"
                      ItemTapped="DetailsListView_ItemTapped">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Frame Margin="10,5"
                                   Padding="15"
                                   CornerRadius="12"
                                   BackgroundColor="#FFFFFF"
                                   HasShadow="True">
                                <StackLayout Orientation="Vertical" Spacing="8">

                                    <!-- عنوان آهنگ و تصویر -->
                                    <StackLayout Orientation="Horizontal" Spacing="15">
                                        <Frame Padding="0"
                                               CornerRadius="4"
                                               HasShadow="False"
                                               HeightRequest="40"
                                               WidthRequest="40"
                                               VerticalOptions="Center"
                                               HorizontalOptions="Start"
                                               Margin="0,0,4,0"
                                               IsClippedToBounds="True">
                                            <Image Source="{Binding ListImageSrc}"
                                                   Aspect="AspectFill"
                                                   HeightRequest="40"
                                                   WidthRequest="40" />
                                        </Frame>

                                        <StackLayout VerticalOptions="Center" HorizontalOptions="FillAndExpand">
                                            <Label Text="{Binding Title}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="#333"
                                                   LineBreakMode="TailTruncation" />

                                            <!-- وضعیت دانلود -->
                                            <Label Text="{Binding DownloadStatus}"
                                                   FontSize="12"
                                                   TextColor="#888"
                                                   IsVisible="{Binding IsDownloading}" />
                                        </StackLayout>
                                    </StackLayout>

                                    <!-- 🔄 Progress Bar دانلود -->
                                    <Grid IsVisible="{Binding IsDownloading}">
                                        <ProgressBar Progress="{Binding DownloadProgress}" 
                                                     HeightRequest="4"
                                                     ProgressColor="#2196F3" />
                                    </Grid>
                                </StackLayout>
                            </Frame>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 🎵 Mini Player -->
            <views:MiniPlayerView Grid.Row="1"
                                  HorizontalOptions="FillAndExpand"
                                  HeightRequest="80" />
        </Grid>
    </ContentPage.Content>
</ContentPage>
