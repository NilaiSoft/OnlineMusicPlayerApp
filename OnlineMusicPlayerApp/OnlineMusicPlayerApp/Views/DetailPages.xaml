<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://xamarin.com/schemas/2020/toolkit"
             x:Class="OnlineMusicPlayerApp.Views.DetailPages"
             BackgroundColor="#F5F0EB"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Content>
        <StackLayout Padding="30" Spacing="25">

            <Label Text="در حال پخش: نغمه‌ای از دل"
                   FontSize="18"
                   TextColor="#3E3E3E"
                   HorizontalOptions="Center" />

            <toolkit:MediaElement x:Name="Player"
                                  HeightRequest="60"
                                  WidthRequest="300"
                                  AutoPlay="False"
                                  ShowsPlaybackControls="True"
                                  BackgroundColor="#EAEAEA"
                                  HorizontalOptions="Center" />

            <Slider x:Name="ProgressSlider"
                    Minimum="0"
                    Maximum="1"
                    Value="0"
                    HorizontalOptions="FillAndExpand"
                    ThumbColor="#888"
                    MinimumTrackColor="#555"
                    MaximumTrackColor="#CCC" />

            <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="20">
                <Button Text="▶ پخش" Clicked="OnPlayClicked" BackgroundColor="#DDE" />
                <Button Text="⏸ توقف" Clicked="OnPauseClicked" BackgroundColor="#DDE" />
            </StackLayout>

        </StackLayout>
    </ContentPage.Content>
</ContentPage>
