<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OnlineMusicPlayerApp.Views.MiniPlayerView"
             HeightRequest="60"
             HorizontalOptions="FillAndExpand"
             BackgroundColor="Transparent">

    <Frame Padding="6"
           CornerRadius="20"
           BackgroundColor="#FFFFFF"
           HasShadow="True"
           VerticalOptions="End"
           HeightRequest="60"
           Margin="0"
           BorderColor="#DDD">

        <StackLayout Orientation="Horizontal"
                     HorizontalOptions="FillAndExpand"
                     VerticalOptions="Center"
                     Spacing="8">

            <Label x:Name="lblMiniTitle"
                   Text="در حال پخش..."
                   FontSize="12"
                   TextColor="#3E3E3E"
                   VerticalOptions="Center"
                   HorizontalOptions="StartAndExpand"
                   LineBreakMode="TailTruncation" />

            <Button x:Name="btnMiniPlay"
                    ImageSource="icon_play1"
                    BackgroundColor="Transparent"
                    WidthRequest="40"
                    HeightRequest="40"
                    Clicked="OnMiniPlayClicked"
                    VerticalOptions="Center"
                    HorizontalOptions="End" />

        </StackLayout>
    </Frame>
</ContentView>
