<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OnlineMusicPlayerApp.Views.MiniPlayerView"
             HeightRequest="60"
             HorizontalOptions="FillAndExpand"
             BackgroundColor="Transparent">

    <Frame Padding="6"
           CornerRadius="20"
           BackgroundColor="#FFFFFF"
           HasShadow="True"
           VerticalOptions="End"
           HeightRequest="60"
           Margin="0"
           BorderColor="#DDD">

        <StackLayout Orientation="Horizontal"
                     HorizontalOptions="FillAndExpand"
                     VerticalOptions="Center"
                     Spacing="8"
                     Padding="6,0">

            <!-- 🖼️ تصویر کاور آهنگ -->
            <Image x:Name="imgMiniCover"
                   Source="default_cover.png"
                   WidthRequest="40"
                   HeightRequest="40"
                   Aspect="AspectFill"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   Margin="0,0,4,0" />

            <!-- 🎵 عنوان آهنگ -->
            <Label x:Name="lblMiniTitle"
                   Text="در حال پخش..."
                   FontSize="12"
                   TextColor="#3E3E3E"
                   VerticalOptions="Center"
                   HorizontalOptions="StartAndExpand"
                   LineBreakMode="TailTruncation" />

            <!-- ⏮️ دکمه قبلی -->
            <ImageButton x:Name="btnMiniPrev"
                         Source="icon_back"
                         BackgroundColor="Transparent"
                         WidthRequest="30"
                         HeightRequest="30"
                         Clicked="OnMiniPrevClicked" />

            <!-- ▶️ دکمه پخش/توقف -->
            <ImageButton x:Name="btnMiniPlay"
                         Source="icon_play1"
                         BackgroundColor="Transparent"
                         WidthRequest="30"
                         HeightRequest="30"
                         Clicked="OnMiniPlayClicked" />

            <!-- ⏭️ دکمه بعدی -->
            <ImageButton x:Name="btnMiniNext"
                         Source="icon_next"
                         BackgroundColor="Transparent"
                         WidthRequest="30"
                         HeightRequest="30"
                         Clicked="OnMiniNextClicked" />

        </StackLayout>
    </Frame>
</ContentView>
