<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OnlineMusicPlayerApp.Views.MiniPlayerView"
             HeightRequest="60"
             HorizontalOptions="FillAndExpand"
             BackgroundColor="Transparent">

    <Grid RowSpacing="0">
        <!-- حالت کامل -->
        <StackLayout Padding="30" Spacing="1">
            <!-- پنل پخش موسیقی -->
            <Frame x:Name="MaximizedPanel"
                       Padding="20"
                       CornerRadius="12"
                       BackgroundColor="#FFFFFF"
                       HasShadow="True"
                       IsVisible="false"
                       VerticalOptions="StartAndExpand">

                <StackLayout Spacing="10">

                    <Label x:Name="lblTitle"
                               FontSize="18"
                               TextColor="#3E3E3E"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />

                    <Image x:Name="CoverImage"
                               Aspect="AspectFill"
                               HorizontalOptions="Center"
                               HeightRequest="200"
                               WidthRequest="200"
                               Margin="0,0,0,10">
                        <Image.Clip>
                            <EllipseGeometry Center="100,100" RadiusX="100" RadiusY="100" />
                        </Image.Clip>
                    </Image>

                    <Grid ColumnSpacing="10" Margin="0,10,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Label x:Name="CurrentTimeLabel"
                                   Grid.Column="0"
                                   Text="0:00"
                                   FontSize="14"
                                   TextColor="#555" />

                        <Slider x:Name="ProgressSlider"
                                    Grid.Column="1"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="0"
                                    ValueChanged="ProgressSlider_ValueChanged"
                                    ThumbColor="#888"
                                    MinimumTrackColor="#555"
                                    MaximumTrackColor="#CCC" />

                        <Label x:Name="TotalTimeLabel"
                                   Grid.Column="2"
                                   Text="0:00"
                                   FontSize="14"
                                   TextColor="#555" />
                    </Grid>

                    <Label x:Name="lblTrackNumber"
                               FontSize="14"
                               TextColor="#666"
                               HorizontalOptions="Center"
                               Margin="0,0,0,10" />

                    <StackLayout Orientation="Horizontal"
                                     HorizontalOptions="Center"
                                     Spacing="30">

                        <Button x:Name="btnPrevious"
                                    ImageSource="icon_back"
                                    BackgroundColor="Transparent"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    Clicked="OnPreviousClicked" />

                        <Button x:Name="btnPlay"
                                    ImageSource="icon_play1"
                                    BackgroundColor="Transparent"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    Clicked="OnPlayClicked" />

                        <Button x:Name="btnNext"
                                    ImageSource="icon_next"
                                    BackgroundColor="Transparent"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    Clicked="OnNextClicked" />
                    </StackLayout>

                </StackLayout>
            </Frame>
        </StackLayout>

        <!-- MiniPlayer پایین صفحه -->
        <Frame x:Name="MiniPlayerFrame"
               Padding="6"
               CornerRadius="20"
               BackgroundColor="#FFFFFF"
               HasShadow="True"
               VerticalOptions="End"
               HeightRequest="60"
               Margin="10"
               IsVisible="true"
               BorderColor="#DDD"
                              GestureRecognizers="{TapGestureRecognizer Tapped='OnMiniPlayerTapped'}">

            <StackLayout Orientation="Horizontal"
                         HorizontalOptions="FillAndExpand"
                         VerticalOptions="Center"
                         Spacing="8"
                         Padding="6,0">

                <Image x:Name="imgMiniCover"
                       Source="default_cover.png"
                       WidthRequest="40"
                       HeightRequest="40"
                       Aspect="AspectFill"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"
                       Margin="0,0,4,0" />

                <Label x:Name="lblMiniTitle"
                       Text="در حال پخش..."
                       FontSize="12"
                       TextColor="#3E3E3E"
                       VerticalOptions="Center"
                       HorizontalOptions="StartAndExpand"
                       LineBreakMode="TailTruncation" />

                <ImageButton x:Name="btnMiniPrev"
                             Source="icon_back"
                             BackgroundColor="Transparent"
                             WidthRequest="30"
                             HeightRequest="30"
                             Clicked="OnMiniPrevClicked" />

                <ImageButton x:Name="btnMiniPlay"
                             Source="icon_play1"
                             BackgroundColor="Transparent"
                             WidthRequest="30"
                             HeightRequest="30"
                             Clicked="OnMiniPlayClicked" />

                <ImageButton x:Name="btnMiniNext"
                             Source="icon_next"
                             BackgroundColor="Transparent"
                             WidthRequest="30"
                             HeightRequest="30"
                             Clicked="OnMiniNextClicked" />
            </StackLayout>
        </Frame>
    </Grid>
</ContentView>
