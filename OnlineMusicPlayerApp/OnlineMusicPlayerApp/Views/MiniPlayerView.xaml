<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OnlineMusicPlayerApp.Views.MiniPlayerView"
             HeightRequest="60"
             HorizontalOptions="FillAndExpand"
             BackgroundColor="Transparent"
             NavigationPage.HasNavigationBar="False">

    <Grid RowSpacing="0">
        <!-- حالت کامل -->
        <StackLayout Padding="30" Spacing="1">
            <Frame x:Name="MaximizedPanel"
                   Padding="10"
                   CornerRadius="12"
                   BackgroundColor="#FFFFFF"
                   HasShadow="True"
                   IsVisible="false"
                   VerticalOptions="FillAndExpand"
                   HorizontalOptions="FillAndExpand">

                <StackLayout Spacing="40">
                    <Label x:Name="lblTitle"
                           FontSize="18"
                           TextColor="#3E3E3E"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />

                    <Image x:Name="CoverImage"
                           Aspect="AspectFill"
                           HorizontalOptions="Center"
                           HeightRequest="300"
                           WidthRequest="300"
                           Margin="0,0,0,10">
                        <Image.Clip>
                            <EllipseGeometry Center="150,150" RadiusX="150" RadiusY="150" />
                        </Image.Clip>
                    </Image>


                    <!-- 🔄 نوار پیشرفت دانلود -->
                    <StackLayout x:Name="DownloadPanel"
                                 IsVisible="False"
                                 Spacing="6"
                                 HorizontalOptions="Center"
                                 Margin="0,10,0,0">
                        <ProgressBar x:Name="DownloadProgressBar"
                                     WidthRequest="200"
                                     Progress="0"
                                     HeightRequest="6"
                                     BackgroundColor="#EEE"
                                     ProgressColor="#888" />
                        <Label x:Name="DownloadMessageLabel"
                               FontSize="12"
                               TextColor="#666"
                               HorizontalOptions="Center"
                               Text="در حال دریافت..." />
                    </StackLayout>

                    <Grid Margin="0,10,0,10"
      RowSpacing="4"
      ColumnSpacing="10">

                        <!-- تعریف ستون‌ها -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- تعریف سطرها -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- لیبل‌ها -->
                            <RowDefinition Height="Auto" />
                            <!-- اسلایدر -->
                        </Grid.RowDefinitions>

                        <!-- لیبل زمان شروع - چپ -->
                        <Label x:Name="CurrentTimeLabel"
           Grid.Row="0"
           Grid.Column="0"
           Text="0:00"
           FontSize="14"
           TextColor="#555"
           HorizontalOptions="Start" />

                        <!-- لیبل زمان پایان - راست -->
                        <Label x:Name="TotalTimeLabel"
           Grid.Row="0"
           Grid.Column="2"
           Text="3:45"
           FontSize="14"
           TextColor="#555"
           HorizontalOptions="End" />

                        <!-- اسلایدر وسط -->
                        <Slider x:Name="ProgressSlider"
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Minimum="0"
            Maximum="1"
            Value="0"
            ValueChanged="ProgressSlider_ValueChanged"
            ThumbColor="#888"
            MinimumTrackColor="#555"
            MaximumTrackColor="#CCC"
            HorizontalOptions="FillAndExpand" />
                    </Grid>


                    <Label x:Name="lblTrackNumber"
                           FontSize="14"
                           TextColor="#666"
                           HorizontalOptions="Center"
                           Margin="0,0,0,10" />

                    <StackLayout Orientation="Horizontal"
                                 HorizontalOptions="Center"
                                 Spacing="30">

                        <Button x:Name="btnPrevious"
                                ImageSource="icon_back"
                                BackgroundColor="Transparent"
                                WidthRequest="50"
                                HeightRequest="50"
                                Clicked="OnPreviousClicked" />

                        <Button x:Name="btnPlay"
                                ImageSource="icon_play1"
                                BackgroundColor="Transparent"
                                WidthRequest="50"
                                HeightRequest="50"
                                Clicked="OnPlayClicked" />

                        <Button x:Name="btnNext"
                                ImageSource="icon_next"
                                BackgroundColor="Transparent"
                                WidthRequest="50"
                                HeightRequest="50"
                                Clicked="OnNextClicked" />
                    </StackLayout>
                </StackLayout>
            </Frame>
        </StackLayout>

        <!-- MiniPlayer پایین صفحه -->
        <Frame x:Name="MiniPlayerFrame"
               Padding="6"
               CornerRadius="20"
               BackgroundColor="#FFFFFF"
               HasShadow="True"
               VerticalOptions="End"
               HeightRequest="60"
               Margin="10"
               IsVisible="true"
               BorderColor="#DDD">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMiniPlayerTapped" />
            </Frame.GestureRecognizers>

            <StackLayout Orientation="Horizontal"
                         HorizontalOptions="FillAndExpand"
                         VerticalOptions="Center"
                         Spacing="8"
                         Padding="6,0">

                <Frame Padding="0"
                       CornerRadius="4"
                       HasShadow="False"
                       HeightRequest="40"
                       WidthRequest="40"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"
                       Margin="0,0,4,0"
                       IsClippedToBounds="True">
                    <Image x:Name="imgMiniCover"
                           Source="default_cover.png"
                           Aspect="AspectFill"
                           HeightRequest="40"
                           WidthRequest="40" />
                </Frame>


                <Label x:Name="lblMiniTitle"
                       Text="در حال پخش..."
                       FontSize="12"
                       TextColor="#3E3E3E"
                       VerticalOptions="Center"
                       HorizontalOptions="StartAndExpand"
                       LineBreakMode="TailTruncation" />

                <ImageButton x:Name="btnMiniPrev"
                             Source="icon_back"
                             BackgroundColor="Transparent"
                             WidthRequest="30"
                             HeightRequest="30"
                             Clicked="OnPreviousClicked" />

                <ImageButton x:Name="btnMiniPlay"
                             Source="icon_play1"
                             BackgroundColor="Transparent"
                             WidthRequest="30"
                             HeightRequest="30"
                             Clicked="OnMiniPlayClicked" />

                <ImageButton x:Name="btnMiniNext"
                             Source="icon_next"
                             BackgroundColor="Transparent"
                             WidthRequest="30"
                             HeightRequest="30"
                             Clicked="OnNextClicked" />
            </StackLayout>
        </Frame>
    </Grid>
</ContentView>
