<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ffimageloading="clr-namespace:FFImageLoading.Forms;assembly=FFImageLoading.Forms"
             xmlns:fftransformations="clr-namespace:FFImageLoading.Transformations;assembly=FFImageLoading"
             x:Class="OnlineMusicPlayerApp.Views.MiniPlayerView"
             BackgroundColor="Transparent"
             NavigationPage.HasNavigationBar="False">

    <Grid RowSpacing="0">
        <!-- حالت کامل -->
        <AbsoluteLayout>

            <ffimageloading:CachedImage x:Name="BlurBackground"
                            Aspect="AspectFill"
                            WidthRequest="600" 
                            HeightRequest="600"
                            DownsampleToViewSize="true"
                            Opacity="0.3"
                            IsVisible="false"
                            AbsoluteLayout.LayoutBounds="0,0,1.9,1.5"
                            AbsoluteLayout.LayoutFlags="All" />
            <StackLayout Padding="30" Spacing="1">
                <Frame x:Name="MaximizedPanel"
                   Padding="10"
                   CornerRadius="12"
                   BackgroundColor="Transparent"
                   HasShadow="True"
                   IsVisible="false"
                   VerticalOptions="FillAndExpand"
                   HorizontalOptions="FillAndExpand">

                    <StackLayout Spacing="30">
                        <!-- عنوان آهنگ -->
                        <ScrollView Orientation="Horizontal"
                                HorizontalOptions="Center"
                                HeightRequest="30">
                            <Label x:Name="lblTitle"
                               FontSize="18"
                               TextColor="#3E3E3E"
                               HorizontalTextAlignment="Start"
                               VerticalTextAlignment="Center" />
                        </ScrollView>

                        <!-- ایکون‌های بالا -->
                        <StackLayout Orientation="Horizontal"
                             HorizontalOptions="Center"
                             Spacing="28">
                            <Image Source="music_playlist_30" WidthRequest="28">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPlaylistClicked"/>
                                </Image.GestureRecognizers>
                            </Image>

                            <Image Source="equalizer_50" WidthRequest="28">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEqualizerClicked"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </StackLayout>

                        <!-- تصویر دایره‌ای آهنگ -->
                        <Frame Padding="0"
                           CornerRadius="150"
                           HeightRequest="300"
                           WidthRequest="300"
                           IsClippedToBounds="True"
                           HorizontalOptions="Center"
                           HasShadow="True"
                           BackgroundColor="Transparent">
                            <Image x:Name="CoverImage"
                               Aspect="AspectFill"
                               HeightRequest="300"
                               WidthRequest="300" />
                        </Frame>

                        <!-- نوار پیشرفت دانلود -->
                        <StackLayout x:Name="DownloadPanel"
                                 IsVisible="False"
                                 Spacing="6"
                                 HorizontalOptions="Center"
                                 Margin="0,10,0,0">
                            <ProgressBar x:Name="DownloadProgressBar"
                                     WidthRequest="200"
                                     Progress="0"
                                     HeightRequest="6"
                                     BackgroundColor="#EEE"
                                     ProgressColor="#888" />
                            <Label x:Name="DownloadMessageLabel"
                               FontSize="12"
                               TextColor="#666"
                               HorizontalOptions="Center"
                               Text="در حال دریافت..." />
                        </StackLayout>

                        <!-- نوار زمان و اسلایدر -->
                        <Grid Margin="0,10,0,10"
                          RowSpacing="4"
                          ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label x:Name="CurrentTimeLabel"
                               Grid.Row="0"
                               Grid.Column="0"
                               Text="0:00"
                               FontSize="14"
                               TextColor="#555"
                               HorizontalOptions="Start" />

                            <Label x:Name="TotalTimeLabel"
                               Grid.Row="0"
                               Grid.Column="2"
                               Text="3:45"
                               FontSize="14"
                               TextColor="#555"
                               HorizontalOptions="End" />

                            <Slider x:Name="ProgressSlider"
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Minimum="0"
                                Maximum="1"
                                Value="0"
                                ValueChanged="ProgressSlider_ValueChanged"
                                ThumbColor="#888"
                                MinimumTrackColor="#555"
                                MaximumTrackColor="#CCC"
                                HorizontalOptions="FillAndExpand" />
                        </Grid>

                        <!-- شماره ترک -->
                        <Label x:Name="lblTrackNumber"
                           FontSize="14"
                           TextColor="#666"
                           HorizontalOptions="Center"
                           Margin="0,0,0,10" />

                        <!-- دکمه‌های کنترل پخش -->
                        <StackLayout Orientation="Horizontal"
                                 HorizontalOptions="Center"
                                 Spacing="30">
                            <ImageButton x:Name="btnPrevious"
                                     Source="icon_back"
                                     BackgroundColor="Transparent"
                                     WidthRequest="36"
                                     HeightRequest="36"
                                     Clicked="OnPreviousClicked" />

                            <ImageButton x:Name="btnPlay"
                                     Source="icon_play1"
                                     BackgroundColor="Transparent"
                                     WidthRequest="36"
                                     HeightRequest="36"
                                     Clicked="OnPlayClicked" />

                            <ImageButton x:Name="btnNext"
                                     Source="icon_next"
                                     BackgroundColor="Transparent"
                                     WidthRequest="36"
                                     HeightRequest="36"
                                     Clicked="OnNextClicked" />
                        </StackLayout>
                    </StackLayout>
                </Frame>
            </StackLayout>
        </AbsoluteLayout>

        <!-- MiniPlayer پایین صفحه -->
        <Frame x:Name="MiniPlayerFrame"
               Padding="0"
               CornerRadius="0"
               BackgroundColor="#FFFFFF"
               HasShadow="True"
               VerticalOptions="End"
               HeightRequest="60"
               Margin="0"
               IsVisible="true"
               BorderColor="#DDD">
            <Frame.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMiniPlayerTapped" />
            </Frame.GestureRecognizers>

            <StackLayout Orientation="Horizontal"
                         HorizontalOptions="FillAndExpand"
                         VerticalOptions="Center"
                         Spacing="8"
                         Padding="6,0">

                <Frame Padding="0"
                       CornerRadius="4"
                       HasShadow="False"
                       HeightRequest="40"
                       WidthRequest="40"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"
                       Margin="0,0,4,0"
                       IsClippedToBounds="True">
                    <Image x:Name="imgMiniCover"
                           Source="default_cover.png"
                           Aspect="AspectFill"
                           HeightRequest="40"
                           WidthRequest="40" />
                </Frame>

                <Label x:Name="lblMiniTitle"
                       Text="در حال پخش..."
                       FontSize="12"
                       TextColor="#3E3E3E"
                       VerticalOptions="Center"
                       HorizontalOptions="StartAndExpand"
                       LineBreakMode="TailTruncation" />

                <ImageButton x:Name="btnMiniPrev"
                             Source="icon_back"
                             BackgroundColor="Transparent"
                             WidthRequest="30"
                             HeightRequest="30"
                             CommandParameter="minPreview"
                             Clicked="OnPreviousClicked" />

                <ImageButton x:Name="btnMiniPlay"
                             Source="icon_play1"
                             BackgroundColor="Transparent"
                             WidthRequest="30"
                             HeightRequest="30"
                             Clicked="OnMiniPlayClicked" />

                <ImageButton x:Name="btnMiniNext"
                             Source="icon_next"
                             BackgroundColor="Transparent"
                             WidthRequest="30"
                             HeightRequest="30"
                             CommandParameter="minNext"
                             Clicked="OnNextClicked" />
            </StackLayout>
        </Frame>
    </Grid>
</ContentView>
