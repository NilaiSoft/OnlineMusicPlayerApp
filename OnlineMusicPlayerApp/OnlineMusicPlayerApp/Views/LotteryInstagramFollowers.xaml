<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             NavigationPage.HasNavigationBar="False"
             Title="{Binding Title}"
             x:Class="LotteryApp.Views.LotteryInstagramFollowers">
    <ContentPage.Content>
        <Grid VerticalOptions="FillAndExpand">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Image Source="img0.png" x:Name="imgPost" 
                   Aspect="Fill" 
                   HeightRequest="300" 
                   VerticalOptions="StartAndExpand"/>
            <StackLayout Orientation="Horizontal" Margin="0,20"
                         HorizontalOptions="Center"
                         VerticalOptions="Center"/>
            <Frame Grid.Row="1" 
                   HasShadow="True" 
                   CornerRadius="10"
                   Padding="-10"
                   Margin="10,10,10,0" HeightRequest="50"
                   VerticalOptions="Start">
                <Grid HorizontalOptions="FillAndExpand" 
                      VerticalOptions="CenterAndExpand">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackLayout Orientation="Vertical"
                                 Grid.Column="0"
                                 Grid.ColumnSpan="3"
                                 VerticalOptions="StartAndExpand">
                        <Button x:Name="btnLoadPost"
                                    ClassId="btnLoadPost"
                                FontSize="10"
                                    Clicked="btnLoadPost_Clicked"
                                    Text="Paste And Load Post"/>
                    </StackLayout>
                    <StackLayout Grid.Column="3" Grid.ColumnSpan="5" Orientation="Vertical" 
                                 VerticalOptions="StartAndExpand">
                        <Entry Placeholder="Enter post url" x:Name="txtUrlPost" />
                    </StackLayout>
                </Grid>
            </Frame>
            <Frame CornerRadius="100" 
                   Grid.Row="3" 
                   HeightRequest="100"
                   WidthRequest="100"
                   HorizontalOptions="Center" 
                   Padding="0"
                   IsClippedToBounds="True">
                <Image Source="img0.png" 
                       Aspect="Fill"
                       x:Name="imgAvatar"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Frame>
            <StackLayout Grid.Row="4" VerticalOptions="CenterAndExpand"
                         HorizontalOptions="CenterAndExpand">
                <Label x:Name="lblUserName"
                       TextColor="DarkRed"
                       FlowDirection="MatchParent"
                       FontSize="30"
                       FontAttributes="Bold" 
                       VerticalOptions="Center"/>
            </StackLayout>
            <StackLayout Grid.Row="5"
                         HorizontalOptions="CenterAndExpand">
                <Label x:Name="lblFullName"
                       TextColor="DarkRed" 
                       FontSize="20"
                       FontAttributes="Bold" 
                       VerticalOptions="Center"/>
            </StackLayout>
            <StackLayout Grid.Row="6"
                         HorizontalOptions="CenterAndExpand">
                <Button x:Name="btnStart"
                       Text="شروع"
                       Clicked="btnStart_Clicked"
                       TextColor="White" 
                       FontSize="20"
                       FontAttributes="Bold" 
                       VerticalOptions="Center"/>
            </StackLayout>
            <StackLayout Grid.Row="5"
                         HorizontalOptions="CenterAndExpand">
                <Button x:Name="btnStartFollowers"
                       Text="فالو کن"
                       Clicked="btnStartFollowers_Clicked"
                       TextColor="White" 
                       FontSize="20"
                       FontAttributes="Bold" 
                       VerticalOptions="Center"/>
            </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>




