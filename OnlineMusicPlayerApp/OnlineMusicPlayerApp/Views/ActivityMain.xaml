<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OnlineMusicPlayerApp.Views.ActivityMain"
             xmlns:views="clr-namespace:OnlineMusicPlayerApp.Views"
             BackgroundColor="#BFB4B2"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Content>
        <Grid x:Name="MainGrid"
          VerticalOptions="FillAndExpand"
          BackgroundColor="AliceBlue">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- دکمه منو -->
            <StackLayout Grid.Row="0"
                     Orientation="Horizontal"
                     HorizontalOptions="Start"
                     Margin="20,60,0,0">

                <ImageButton Source="menu.png"
                         x:Name="btnMenu"
                         Clicked="btnMenu_Clicked"
                         BackgroundColor="Transparent"
                         WidthRequest="40"
                         HeightRequest="40"/>
            </StackLayout>


            <!-- تصویر -->
            <Frame Grid.Row="1"
               x:Name="CoverFrame"
               CornerRadius="40"
               HasShadow="True"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               IsClippedToBounds="True">

                <Image x:Name="CoverImage"
                   Source="images.png"
                   Aspect="AspectFill"
                   HorizontalOptions="FillAndExpand"
                   VerticalOptions="FillAndExpand"/>
            </Frame>


            <!-- Playlist -->
            <Button Grid.Row="2"
                Text="🎵 Playlist"
                IsVisible="false"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="White"
                BackgroundColor="#415A77"
                CornerRadius="16"
                Margin="30,10"
                Padding="12"
                HorizontalOptions="Center"
                Clicked="OnPlaylistClicked"/>


            <!-- Equalizer -->
            <Button Grid.Row="3"
                IsVisible="false"
                Text="🎵 Equlizer"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="White"
                BackgroundColor="#415A77"
                CornerRadius="16"
                Margin="30,10"
                Padding="12"
                x:Name="btnEqulizer"
                HorizontalOptions="Center"
                Clicked="btnEqulizer_Clicked"/>


            <!-- محتوای اصلی -->
            <Grid Grid.Row="4">
            </Grid>


            <!-- MiniPlayer به صورت Overlay روی کل صفحه -->
            <views:MiniPlayerView
            x:Name="MiniPlayerViewControl"
            Grid.Row="0"
            Grid.RowSpan="6"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            BackgroundColor="Transparent"/>

        </Grid>
    </ContentPage.Content>
</ContentPage>
